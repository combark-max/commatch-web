# Supabase project API URL. Public; required in Development, Preview, and Production.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous client key. Public; required in Development, Preview, and Production.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key. Private server secret; required in environments that run privileged API routes.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push VAPID public key. Public; required in environments where Web Push subscription is enabled.
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=

# Web Push VAPID private key. Private server secret; required in environments that deliver Web Push.
WEB_PUSH_VAPID_PRIVATE_KEY=

# Web Push contact subject (for example, a mailto address). Server configuration; required with Web Push delivery.
WEB_PUSH_VAPID_SUBJECT=

# Shared secret for the internal Push drain endpoint. Private server secret; required where that endpoint is used.
PUSH_WORKER_SECRET=

# Authorization secret for the scheduled Push drain route. Private server secret; required where the cron route is used.
CRON_SECRET=

# Set automatically by Vercel. Public platform flag used for trusted client-IP handling; do not set manually.
VERCEL=
